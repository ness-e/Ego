{
  "name": "ego-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Ego — Sistema Operativo Cognitivo (SOC)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ego/desktop dev",
    "build:renderer": "pnpm --filter @ego/renderer build",
    "build:desktop": "pnpm --filter @ego/desktop build",
    "build": "pnpm --filter @ego/renderer build && pnpm --filter @ego/desktop build",
    "build:verify": "pnpm --filter @ego/desktop build:verify",
    "dist": "pnpm --filter @ego/desktop dist && node scripts/generate-checksums.cjs apps/desktop/release",
    "typecheck": "pnpm -r typecheck",
    "lint": "node scripts/verify-lint-budget.mjs && pnpm run typecheck",
    "lint:oxlint": "node scripts/verify-lint-budget.mjs",
    "test": "node scripts/preflight-disk.mjs && pnpm -r --no-bail --filter \"!@ego/avatar\" --filter \"!@ego/gui-tests\" --filter \"!@ego/recovery\" run test && pnpm --filter @ego/recovery exec vitest run --test-timeout=20000 && pnpm --filter @ego/avatar run test && pnpm --filter @ego/gui-tests run test",
    "test:memory": "pnpm --filter @ego/memory test",
    "test:e2e": "pnpm --filter @ego/e2e-tests test",
    "test:e2e:electron": "pnpm --dir tests/gui run test:e2e:electron",
    "test:gui": "pnpm --dir tests/gui run test:gui",
    "audit:security": "node scripts/audit-security.mjs",
    "audit:debt": "node scripts/audit-debt.mjs",
    "audit:debt:baseline": "node scripts/audit-debt.mjs --write-baseline scripts/debt-baseline.json",
    "telemetry:export": "node scripts/export-telemetry.mjs",
    "verify:ci": "node scripts/verify-ci-triggers.mjs",
    "verify:harness": "node scripts/verify-harness.mjs",
    "verify:all": "pnpm run verify:ci && pnpm run verify:harness && pnpm run vantadb:check && pnpm run verify:ci:gates && pnpm run verify:attribution && pnpm run verify:bundle",
    "docs:lint": "node scripts/check-docs-lint.mjs",
    "docs:lint:baseline": "node scripts/check-docs-lint.mjs --write-baseline",
    "changelog:preview": "git cliff --unreleased",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "lint:commit": "commitlint --edit",
    "prepare": "husky",
    "disk:check": "node scripts/preflight-disk.mjs",
    "disk:check:json": "node scripts/preflight-disk.mjs --json",
    "disk:clean": "node scripts/preflight-disk.mjs --clean --budget-gb 0",
    "vantadb:check": "node scripts/verify-vantadb-resolution.mjs",
    "audit:extraction:test": "node scripts/test-audit-extraction-gates.mjs",
    "lint:budget:check": "node scripts/verify-lint-budget.mjs",
    "lint:budget:test": "node scripts/test-verify-lint-budget.mjs",
    "verify:ci:gates": "node scripts/verify-ci-gates.mjs",
    "verify:ci:gates:test": "node scripts/test-verify-ci-gates.mjs",
    "verify:attribution": "node scripts/verify-attribution.mjs",
    "verify:attribution:test": "node scripts/test-verify-attribution.mjs",
    "verify:bundle": "node scripts/verify-bundle-runtime.mjs",
    "verify:bundle:test": "node scripts/test-verify-bundle-runtime.mjs",
    "inventory:tautological": "node scripts/inventory-tautological-tests.mjs",
    "inventory:tautological:test": "node scripts/test-inventory-tautological-tests.mjs",
    "lint:source-contracts": "node apps/desktop/scripts/lint/source-contracts.lint.mjs"
  },
  "pnpm": {
    "overrides": {
      "app-builder-lib": "26.15.3",
      "builder-util-runtime": "^9.7.0",
      "tinypool": "^2.2.0",
      "vitepress>vite": "^6.4.4"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^22.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "1.87.0",
    "typescript": "^5.6.3",
    "vantadb": "0.9.0",
    "vantadb-node": "0.9.0",
    "vitepress": "1.6.4"
  }
}
