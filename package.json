{
  "name": "ego-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Ego — Sistema Operativo Cognitivo (SOC)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ego/desktop dev",
    "build:renderer": "pnpm --filter @ego/renderer build",
    "build:desktop": "pnpm --filter @ego/desktop build",
    "build": "pnpm --filter @ego/renderer build && pnpm --filter @ego/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "echo [lint] Typecheck verification passes && pnpm run typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @ego/memory test"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "typescript": "^5.6.3"
  }
}
