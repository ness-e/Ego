# Carpetas de herramientas de IA / configuración local
.*
!.gitignore
!.github/
!.agents/
!.oxlintrc.json
!.lintstagedrc.mjs
!.husky/
.agents/node_modules/
.agents/**/node_modules/

# Dependencias
node_modules/
.pnpm-store/

# Build
dist/
out/
.next/
*.tsbuildinfo

# Artefactos de build de dependencias externas (B6 / DIST-09).
# El binding napi-rs de VantaDB se empaqueta como tarball para poder
# instalarlo sin un checkout hermano, pero el tarball es un ARTEFACTO DE
# BUILD: no se versiona (lo produce `scripts/prepare-vantadb-tarball.mjs`
# desde un checkout de ness-e/Vantadb). Flujo completo en scripts/README.md.
*.tgz
vendor/vantadb-node/
# Restos de instalaciones interrumpidas del store de pnpm.
node_modules/.pnpm/*_tmp_*/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# IDE
*.swp
*.swo

# Archivos de base de datos local
*.db
!packages/**/*.db

# Archive de planes y tareas completadas (histórico local, fuera de git)
docs/agent-ops/plans/archive/
docs/agent-ops/tasks/archive/

# Repos de referencia (clones de terceros, no son código de Ego)
repos-referencia/

# Python cache
__pycache__/
*.pyc

# Worktrees
.ego-worktrees/

# ── Artefactos de auditoría visual (Ola 6, A7) ─────────────────────────────
# Los generadores (`apps/desktop/scripts/run-design-audit.ps1`,
# `design-audit-headless.mjs`, `ego-browser-audit.mjs`) escriben capturas
# (`<OUT>/shots/*.png`) y un `<OUT>/report.json`. Por defecto `OUT` es
# `%TEMP%\ego-audit` (fuera del repo), pero si se lanzan con `-Out` apuntando
# al repo —o con la config `%TEMP%\ego-audit-config.json` con `dir` así—
# dejan artefactos sueltos que hay que limpiar a mano.
#
# PATRONES ANCLADOS A LA RAÍZ a propósito: el repo versiona 36 PNG legítimos
# (`docs/public/…`, `images/`, `packages/avatar/captures/…`,
# `.agents/skills/*/assets/`). Un `*.png` global los ignoraría.
#   · `/*.png`             → capturas sueltas en la raíz
#   · `/.playwright-cli/`  → directorio de salida de la herramienta playwright-cli
#   · `/audit-artifacts/`  → artefactos de auditoría agrupados
#   · `/shots/`            → `<OUT>/shots/` cuando OUT = raíz del repo
#   · `/report.json`       → `<OUT>/report.json` cuando OUT = raíz del repo
/*.png
/.playwright-cli/
/audit-artifacts/
/shots/
/report.json
