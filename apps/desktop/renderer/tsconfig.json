{
  // F5T11/M31: extiende la base canónica (strict + NodeNext por defecto) y
  // re-declara solo lo propio del bundler web (ESNext/bundler/JSX/DOM/sin
  // emit). El `include` cubre `hooks/` y `test/` para que el typecheck de CI
  // los audite (antes solo entraban por importación transitiva).
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],

    /* Bundler mode */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // T5 / A6 (Ola 1b): el motor de personaje se importa desde el PAQUETE
      // `@ego/avatar` (fuente canónica, ADR-0018). El espejo vendorizado
      // sigue siendo el fallback (decisión D5 del owner: las tres copias se
      // mantienen). Estas rutas sustituyen al enlace de workspace hasta que
      // A7 cierre el lockfile (`workspace:*` ya declarado en este
      // `package.json` y en el de `apps/desktop`).
      "@ego/avatar/runtime/avatar-element.js": [
        "../../../packages/avatar/src/runtime/avatar-element.d.ts"
      ],
      "@ego/avatar/runtime/sound.js": [
        "../../../packages/avatar/src/runtime/sound.d.ts"
      ],
      // Ola 12 · A4: el vocabulario canónico del motor (para cotejarlo en un
      // test TIPADO: el enum del renderer, la lista de no-mapeables y la
      // magnitud que el motor declara).
      "@ego/avatar/runtime/profile.js": [
        "../../../packages/avatar/src/runtime/profile.d.ts"
      ]
    }
  },
  "include": ["src", "components", "lib", "hooks", "test", "floating"],
  // T0 (Ola 1b): el corpus de atribución MIT que A6 replicó dentro del
  // espejo vendorizado (`floating/vendor/avatar/vendor/**`) es material
  // legal de SOLO LECTURA: no es código de runtime de Ego, no debe
  // compilarse ni typecheckearse (le faltan los tipos de `@tauri-apps/api`
  // y usa un tsconfig propio). Excluirlo aquí lo saca del typecheck del
  // renderer sin borrarlo: la cadena de atribución MIT debe seguir siendo
  // resoluble desde las dos copias (upstream / paquete / vendorizada).
  "exclude": [
    "node_modules",
    "dist",
    "floating/vendor/avatar/vendor"
  ]
}
