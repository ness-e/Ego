{
  "name": "@ego/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && electron-vite build && node scripts/copy-avatar-attribution.cjs && node scripts/verify-dist.cjs",
    "build:verify": "node scripts/verify-dist.cjs",
    "design:lint": "node scripts/design-lint.cjs",
    "design:lint:json": "node scripts/design-lint.cjs --json",
    "dist": "electron-builder --config electron-builder.config.cjs",
    "pack": "electron-builder --dir --config electron-builder.config.cjs",
    "dev": "electron-vite dev",
    "dev:renderer": "pnpm --filter @ego/renderer dev",
    "pretest": "node ../../scripts/ensure-fresh-dist.cjs",
    "smoke:native": "node scripts/smoke-native-packaged.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint:source-contracts": "node scripts/lint/source-contracts.lint.mjs"
  },
  "dependencies": {
    "@ego/avatar": "workspace:*",
    "@ego/dailystate": "workspace:*",
    "@ego/decision": "workspace:*",
    "@ego/domains": "workspace:*",
    "@ego/events": "workspace:*",
    "@ego/execution": "workspace:*",
    "@ego/integrations": "workspace:*",
    "@ego/knowledge": "workspace:*",
    "@ego/memory": "workspace:*",
    "@ego/models": "workspace:*",
    "@ego/recovery": "workspace:*",
    "@ego/runtime": "workspace:*",
    "@ego/security": "workspace:*",
    "@ego/subegos": "workspace:*",
    "@ego/tasks": "workspace:*",
    "@ego/tools": "workspace:*",
    "@ego/ui-runtime": "workspace:*",
    "vantadb": "0.9.0",
    "vantadb-node": "0.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "msw": "^2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7",
    "wait-on": "^9.5.1"
  }
}
