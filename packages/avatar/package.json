{
  "name": "@ego/avatar",
  "version": "0.1.0",
  "description": "Motor de personaje de Ego: semilla -> genoma -> organismo vivo con estados cognitivos. Web Component <ego-avatar> con motor SVG y motor canvas (Robot Studio).",
  "license": "MIT",
  "keywords": [
    "avatar",
    "generative",
    "svg",
    "web-component",
    "deterministic",
    "ego"
  ],
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./static": "./src/render/static.js",
    "./studio": "./src/studio/index.js",
    "./runtime/avatar-element.js": "./src/runtime/avatar-element.js",
    "./runtime/sound.js": "./src/runtime/sound.js",
    "./runtime/profile.js": "./src/runtime/profile.js"
  },
  "files": [
    "src",
    "dist",
    "index.d.ts",
    "README.md",
    "DESIGN.md",
    "RESEARCH.md",
    "LICENSE",
    "LICENSE.md",
    "NOTICE",
    "provenance.manifest.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test tests/",
    "geometry:check": "node scripts/compare-geometry.mjs --check tests/golden/geometry.json src",
    "geometry:record": "node scripts/compare-geometry.mjs --record tests/golden/geometry.json src",
    "bridge:check": "node scripts/check-bridge.mjs",
    "upstream:check": "node scripts/check-upstream-divergence.mjs",
    "upstream:declare": "node scripts/check-upstream-divergence.mjs --update",
    "sync:check": "node scripts/sync-check.mjs",
    "sync:write": "node scripts/sync-check.mjs --write",
    "attribution:check": "node scripts/check-attribution.mjs",
    "attribution:declare": "node scripts/check-attribution.mjs --fix",
    "provenance:check": "node scripts/check-attribution.mjs",
    "capture:visuals": "node scripts/capture-visuals.mjs --out captures/current",
    "no-verbatim:check": "node scripts/check-no-verbatim.mjs",
    "no-verbatim:all": "node scripts/check-no-verbatim.mjs --all"
  },
  "dependencies": {},
  "devDependencies": {}
}
